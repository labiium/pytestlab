{
  "$defs": {
    "AccuracySpec": {
      "additionalProperties": false,
      "description": "Represents a single accuracy specification for a measurement mode.\nThe standard deviation (sigma) is typically calculated as:\nsqrt((percent_reading * reading)^2 + (offset_value)^2)\nor other forms depending on how specs are given (e.g., % of range).",
      "properties": {
        "percent_reading": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accuracy as a percentage of the reading (e.g., 0.0001 for 0.01%)",
          "title": "Percent Reading"
        },
        "offset_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fixed offset accuracy in units of the measurement (e.g., 0.005 V)",
          "title": "Offset Value"
        },
        "percent_range": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accuracy as a percentage of the range (e.g., 0.0001 for 0.01%)",
          "title": "Percent Range"
        }
      },
      "title": "AccuracySpec",
      "type": "object"
    },
    "CalibrationSpec": {
      "description": "Specification for calibration capabilities.",
      "properties": {
        "self_calibration": {
          "default": false,
          "description": "Whether self-calibration is supported",
          "title": "Self Calibration",
          "type": "boolean"
        },
        "external_calibration": {
          "default": false,
          "description": "Whether external calibration is supported",
          "title": "External Calibration",
          "type": "boolean"
        },
        "calibration_interval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recommended calibration interval in days",
          "title": "Calibration Interval"
        },
        "required_scpi_commands": {
          "description": "Required SCPI command aliases for calibration functionality (e.g., ['calibrate', 'calibration_status'])",
          "items": {
            "type": "string"
          },
          "title": "Required Scpi Commands",
          "type": "array"
        }
      },
      "title": "CalibrationSpec",
      "type": "object"
    },
    "FunctionSpec": {
      "description": "Specification for a measurement function.",
