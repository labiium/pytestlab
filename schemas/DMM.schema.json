    "RangeSpec": {
      "description": "Specification for a range with accuracy information.",
      "properties": {
        "min": {
          "description": "Minimum range value",
          "title": "Min",
          "type": "number"
        },
        "max": {
          "description": "Maximum range value",
          "title": "Max",
          "type": "number"
        },
        "units": {
