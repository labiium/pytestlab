{
  "$defs": {
    "AccuracySpec": {
      "additionalProperties": false,
      "description": "Represents a single accuracy specification for a measurement mode.\nThe standard deviation (sigma) is typically calculated as:\nsqrt((percent_reading * reading)^2 + (offset_value)^2)\nor other forms depending on how specs are given (e.g., % of range).",
      "properties": {
        "percent_reading": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accuracy as a percentage of the reading (e.g., 0.0001 for 0.01%)",
          "title": "Percent Reading"
        },
        "offset_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fixed offset accuracy in units of the measurement (e.g., 0.005 V)",
          "title": "Offset Value"
        },
        "percent_range": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accuracy as a percentage of the range (e.g., 0.0001 for 0.01%)",
          "title": "Percent Range"
        }
      },
      "title": "AccuracySpec",
      "type": "object"
    },
    "ChannelSpec": {
      "description": "Specification for a single power supply channel.",
      "properties": {
        "description": {
          "description": "Channel description",
          "title": "Description",
          "type": "string"
        },
        "voltage_range": {
          "$ref": "#/$defs/RangeSpec",
          "description": "Voltage range supported by this channel"
        },
        "current_limit_range": {
          "$ref": "#/$defs/RangeSpec",
          "description": "Current limit range supported by this channel"
        },
        "power_limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum power limit in Watts",
          "title": "Power Limit"
        },
        "slew_rate_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RangeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slew rate range in V/s"
        },
        "required_scpi_commands": {
          "description": "Required SCPI command aliases for channel functionality (e.g., ['set_voltage', 'set_current', 'set_slew_rate'])",
          "items": {
            "type": "string"
          },
          "title": "Required Scpi Commands",
          "type": "array"
        }
      },
      "required": [
        "description",
        "voltage_range",
        "current_limit_range"
      ],
      "title": "ChannelSpec",
      "type": "object"
    },
    "CommunicationSpec": {
      "description": "Specification for communication features.",
