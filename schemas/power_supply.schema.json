          "type": "boolean"
        },
        "parallel_operation": {
          "default": false,
          "description": "Whether parallel operation is supported",
          "title": "Parallel Operation",
          "type": "boolean"
        },
        "series_operation": {
          "default": false,
          "description": "Whether series operation is supported",
          "title": "Series Operation",
          "type": "boolean"
        },
        "required_scpi_commands": {
          "description": "Required SCPI command aliases for communication functionality (e.g., ['set_remote_sensing', 'set_parallel_mode'])",
          "items": {
            "type": "string"
          },
          "title": "Required Scpi Commands",
          "type": "array"
        }
      },
      "title": "CommunicationSpec",
      "type": "object"
    },
    "MeasurementSpec": {
      "description": "Specification for measurement capabilities.",
