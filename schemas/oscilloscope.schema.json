{
  "$defs": {
    "AccuracySpec": {
      "additionalProperties": false,
      "description": "Represents a single accuracy specification for a measurement mode.\nThe standard deviation (sigma) is typically calculated as:\nsqrt((percent_reading * reading)^2 + (offset_value)^2)\nor other forms depending on how specs are given (e.g., % of range).",
      "properties": {
        "percent_reading": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accuracy as a percentage of the reading (e.g., 0.0001 for 0.01%)",
          "title": "Percent Reading"
        },
        "offset_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fixed offset accuracy in units of the measurement (e.g., 0.005 V)",
          "title": "Offset Value"
        }
      },
      "title": "AccuracySpec",
      "type": "object"
    },
    "Channel": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "Channel description",
          "title": "Description",
          "type": "string"
        },
        "channel_range": {
          "$ref": "#/$defs/Range",
          "description": "Vertical range of the channel"
        },
        "input_coupling": {
          "description": "Supported input coupling types (e.g., AC, DC, GND)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Coupling",
          "type": "array"
        },
        "input_impedance": {
          "description": "Input impedance in Ohms",
          "title": "Input Impedance",
          "type": "number"
        },
        "probe_attenuation": {
          "description": "Supported probe attenuation factors (e.g., 1, 10)",
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Probe Attenuation",
          "type": "array"
        },
        "timebase": {
          "$ref": "#/$defs/Timebase"
        }
      },
      "required": [
        "description",
        "channel_range",
        "input_coupling",
        "input_impedance",
        "probe_attenuation",
        "timebase"
      ],
      "title": "Channel",
      "type": "object"
    },
    "CommandSpec": {
      "additionalProperties": false,
      "properties": {
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        },
        "sequence": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "defaults": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "title": "Defaults",
          "type": "object"
        },
        "validators": {
          "additionalProperties": {
            "$ref": "#/$defs/RangeValidator"
          },
          "title": "Validators",
          "type": "object"
        },
        "enums": {
          "additionalProperties": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "type": "object"
          },
          "title": "Enums",
          "type": "object"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResponseSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CommandSpec",
      "type": "object"
    },
    "CommandsQueries": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "additionalProperties": {
            "$ref": "#/$defs/CommandSpec"
          },
          "title": "Commands",
          "type": "object"
        },
        "queries": {
          "additionalProperties": {
            "$ref": "#/$defs/CommandSpec"
          },
          "title": "Queries",
          "type": "object"
        }
      },
      "title": "CommandsQueries",
      "type": "object"
    },
    "FFT": {
      "additionalProperties": false,
      "properties": {
        "window_types": {
          "description": "Supported FFT window types (e.g., Hanning, Flattop)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Window Types",
          "type": "array"
        },
        "units": {
          "description": "Supported FFT units (e.g., dBV, Vrms)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "window_types",
        "units"
      ],
      "title": "FFT",
      "type": "object"
    },
    "FRAnalysis": {
      "additionalProperties": false,
      "properties": {
        "sweep_points": {
          "$ref": "#/$defs/Range",
          "description": "Range for number of sweep points"
        },
        "load": {
          "description": "Supported load impedance values for FRA",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Load",
          "type": "array"
        },
        "trace": {
          "description": "Supported trace types for FRA (e.g., Gain, Phase)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Trace",
          "type": "array"
        },
        "mode": {
          "description": "Supported FRA modes (e.g., Bode, Impedance)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Mode",
          "type": "array"
        }
      },
      "required": [
        "sweep_points",
        "load",
        "trace",
        "mode"
      ],
      "title": "FRAnalysis",
      "type": "object"
    },
    "FunctionGenerator": {
      "additionalProperties": false,
      "properties": {
        "waveform_types": {
          "description": "Supported waveform types (e.g., Sine, Square)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Waveform Types",
          "type": "array"
        },
        "supported_states": {
          "description": "Supported states (e.g., ON, OFF)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported States",
          "type": "array"
        },
        "offset": {
          "$ref": "#/$defs/Range",
          "description": "Offset range"
        },
        "frequency": {
          "$ref": "#/$defs/Range",
          "description": "Frequency range"
        },
        "amplitude": {
          "$ref": "#/$defs/Range",
          "description": "Amplitude range"
        }
      },
      "required": [
        "waveform_types",
        "supported_states",
        "offset",
        "frequency",
        "amplitude"
      ],
      "title": "FunctionGenerator",
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "properties": {
        "min_val": {
          "description": "Minimum value of the range (inclusive)",
          "title": "Min Val",
          "type": "number"
        },
        "max_val": {
          "description": "Maximum value of the range (inclusive)",
          "title": "Max Val",
          "type": "number"
        }
      },
      "required": [
        "min_val",
        "max_val"
      ],
      "title": "Range",
      "type": "object"
    },
    "RangeValidator": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "title": "Min",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "RangeValidator",
      "type": "object"
    },
    "ResponseSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "raw",
          "enum": [
            "raw",
            "str",
            "int",
            "float",
            "csv",
            "csv_int",
            "csv_float",
            "csv_dict",
            "binblock"
          ],
          "title": "Type",
          "type": "string"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "delimiter": {
          "default": ",",
          "title": "Delimiter",
          "type": "string"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "title": "ResponseSpec",
      "type": "object"
    },
    "SCPISection": {
      "properties": {
        "commands": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/CommandSpec"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commands"
        },
        "queries": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/CommandSpec"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queries"
        },
        "variants": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/CommandsQueries"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variants"
        },
        "default_variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Variant"
        },
        "feature_mappings": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declarative feature mapping: { feature_name: { required_scpi: [...], optional_scpi: [...] } }",
          "title": "Feature Mappings"
        }
      },
      "title": "SCPISection",
      "type": "object"
    },
    "Timebase": {
      "additionalProperties": false,
      "properties": {
        "range": {
          "$ref": "#/$defs/Range",
          "description": "Timebase range settings"
        },
        "horizontal_resolution": {
          "description": "Horizontal resolution",
          "title": "Horizontal Resolution",
          "type": "number"
        }
      },
      "required": [
        "range",
        "horizontal_resolution"
      ],
      "title": "Timebase",
      "type": "object"
    },
    "Trigger": {
      "additionalProperties": false,
      "properties": {
        "types": {
          "description": "Supported trigger types (e.g., Edge, Pulse, Runt)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Types",
          "type": "array"
        },
        "modes": {
          "description": "Supported trigger modes (e.g., Auto, Normal, Single)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Modes",
          "type": "array"
        },
        "slopes": {
          "description": "Supported trigger slopes (e.g., Rising, Falling, Either)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Slopes",
          "type": "array"
        }
      },
      "required": [
        "types",
        "modes",
        "slopes"
      ],
      "title": "Trigger",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "manufacturer": {
      "description": "Manufacturer of the instrument",
      "title": "Manufacturer",
      "type": "string"
    },
    "model": {
      "description": "Model number of the instrument",
      "title": "Model",
      "type": "string"
    },
    "device_type": {
      "const": "oscilloscope",
      "default": "oscilloscope",
      "description": "Type of the device (oscilloscope)",
      "title": "Device Type",
      "type": "string"
    },
    "serial_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Serial number of the instrument",
      "title": "Serial Number"
    },
    "address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Instrument connection address (e.g., VISA resource string)",
      "title": "Address"
    },
    "measurement_accuracy": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AccuracySpec"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "Measurement accuracy specifications",
      "title": "Measurement Accuracy"
    },
    "scpi": {
      "anyOf": [
        {
          "$ref": "#/$defs/SCPISection"
        },
        {
          "type": "null"
        }
      ],
      "description": "SCPI section typed by Pydantic. Supports direct commands/queries or variants."
    },
    "scpi_variant": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Name of the variant inside scpi.variants to be used with this instrument.  Leave empty if not using the multi-variant feature.",
      "title": "Scpi Variant"
    },
    "trigger": {
      "$ref": "#/$defs/Trigger",
      "description": "Trigger system configuration"
    },
    "channels": {
      "description": "List of channel configurations",
      "items": {
        "$ref": "#/$defs/Channel"
      },
      "minItems": 1,
      "title": "Channels",
      "type": "array"
    },
    "bandwidth": {
      "description": "Analog bandwidth of the oscilloscope in Hz",
      "exclusiveMinimum": 0,
      "title": "Bandwidth",
      "type": "number"
    },
    "sampling_rate": {
      "description": "Maximum sampling rate in Samples/sec",
      "exclusiveMinimum": 0,
      "title": "Sampling Rate",
      "type": "number"
    },
    "memory": {
      "description": "Maximum memory depth (e.g., in points or seconds)",
      "exclusiveMinimum": 0,
      "title": "Memory",
      "type": "number"
    },
    "waveform_update_rate": {
      "description": "Waveform update rate in waveforms/sec",
      "exclusiveMinimum": 0,
      "title": "Waveform Update Rate",
      "type": "number"
    },
    "fft": {
      "anyOf": [
        {
          "$ref": "#/$defs/FFT"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "FFT capabilities, if available"
    },
    "function_generator": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunctionGenerator"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Integrated function generator capabilities, if available"
    },
    "franalysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/FRAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Frequency Response Analysis capabilities, if available"
    },
    "timebase_settings": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timebase"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Global timebase settings, if applicable beyond per-channel"
    }
  },
  "required": [
    "manufacturer",
    "model",
    "trigger",
    "channels",
    "bandwidth",
    "sampling_rate",
    "memory",
    "waveform_update_rate"
  ],
  "title": "OscilloscopeConfig",
  "type": "object"
}
