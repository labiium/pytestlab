    "manufacturer": {
      "description": "Manufacturer of the instrument",
      "title": "Manufacturer",
      "type": "string"
    },
    "model": {
      "description": "Model number of the instrument",
      "title": "Model",
      "type": "string"
    },
    "device_type": {
      "description": "Type of the device (e.g., 'PSU', 'Oscilloscope')",
      "title": "Device Type",
      "type": "string"
    },
    "address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Instrument connection address (e.g., VISA resource string)",
      "title": "Address"
    },
    "measurement_accuracy": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AccuracySpec"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "Measurement accuracy specifications",
      "title": "Measurement Accuracy"
    },
    "scpi": {
      "anyOf": [
        {
          "$ref": "#/$defs/SCPISection"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "SCPI section with command specifications, aliases, and feature mappings. Must contain 'commands:' and/or 'queries:' or a 'variants:' block."
    },
    "scpi_variant": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Name of the variant inside scpi.variants to be used with this instrument.  Leave empty if not using the multi-variant feature.",
      "title": "Scpi Variant"
    },
    "operating_modes": {
      "$ref": "#/$defs/OperatingModesSpec",
      "description": "Operating mode specifications"
    },
    "transient": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransientSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Transient capabilities"
    },
    "battery_test": {
      "anyOf": [
        {
          "$ref": "#/$defs/BatteryTestSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Battery testing capabilities"
    },
    "data_acquisition": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataAcquisitionSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Data acquisition capabilities"
    },
    "core_scpi_commands": {
      "description": "Required SCPI command aliases for core functionality (e.g., ['set_input_state', 'get_input_state'])",
      "items": {
        "type": "string"
      },
      "title": "Core Scpi Commands",
      "type": "array"
    },
    "input_scpi_commands": {
      "description": "Required SCPI command aliases for input functionality (e.g., ['set_input_state', 'input_short_state'])",
      "items": {
        "type": "string"
      },
      "title": "Input Scpi Commands",
      "type": "array"
    },
    "slew_rate_scpi_commands": {
      "description": "Required SCPI command aliases for slew rate functionality (e.g., ['mode_set_slew', 'mode_set_range'])",
      "items": {
        "type": "string"
      },
      "title": "Slew Rate Scpi Commands",
      "type": "array"
    },
    "measurement_scpi_commands": {
      "description": "Required SCPI command aliases for measurement functionality (e.g., ['measure', 'mode_get_range'])",
      "items": {
        "type": "string"
