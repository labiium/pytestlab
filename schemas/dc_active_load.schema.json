{
  "$defs": {
    "AccuracySpec": {
      "additionalProperties": false,
      "description": "Represents a single accuracy specification for a measurement mode.\nThe standard deviation (sigma) is typically calculated as:\nsqrt((percent_reading * reading)^2 + (offset_value)^2)\nor other forms depending on how specs are given (e.g., % of range).",
      "properties": {
        "percent_reading": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accuracy as a percentage of the reading (e.g., 0.0001 for 0.01%)",
          "title": "Percent Reading"
        },
        "offset_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fixed offset accuracy in units of the measurement (e.g., 0.005 V)",
          "title": "Offset Value"
        },
        "percent_range": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accuracy as a percentage of the range (e.g., 0.0001 for 0.01%)",
          "title": "Percent Range"
        }
      },
      "title": "AccuracySpec",
      "type": "object"
    },
    "BatteryTestSpec": {
      "description": "Specification for battery testing capabilities.",
      "properties": {
        "voltage_cutoff_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RangeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Voltage cutoff range"
        },
        "capacity_cutoff_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RangeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Capacity cutoff range in Ah"
        },
        "timer_cutoff_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RangeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timer cutoff range in seconds"
        },
        "required_scpi_commands": {
          "description": "Required SCPI command aliases for battery testing (e.g., ['battery_enable', 'battery_cutoff_voltage', 'battery_cutoff_capacity'])",
          "items": {
            "type": "string"
          },
          "title": "Required Scpi Commands",
          "type": "array"
        }
      },
      "title": "BatteryTestSpec",
      "type": "object"
    },
    "DataAcquisitionSpec": {
      "description": "Specification for data acquisition capabilities.",
      "properties": {
        "scope_points": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of scope data points",
          "title": "Scope Points"
        },
        "datalogger_points": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of datalogger points",
          "title": "Datalogger Points"
        },
        "required_scpi_commands": {
          "description": "Required SCPI command aliases for data acquisition (e.g., ['fetch_array', 'fetch_datalogger'])",
          "items": {
            "type": "string"
          },
          "title": "Required Scpi Commands",
          "type": "array"
        }
      },
      "title": "DataAcquisitionSpec",
      "type": "object"
    },
    "ModeSpec": {
      "description": "Specification for an operating mode.",
      "properties": {
        "ranges": {
          "description": "Available ranges for this mode",
          "items": {
            "$ref": "#/$defs/RangeSpec"
          },
          "title": "Ranges",
          "type": "array"
        },
        "required_scpi_commands": {
          "description": "Required SCPI command aliases for this mode (e.g., ['set_mode', 'set_load'])",
          "items": {
            "type": "string"
          },
          "title": "Required Scpi Commands",
          "type": "array"
        }
      },
      "title": "ModeSpec",
      "type": "object"
    },
    "OperatingModesSpec": {
      "description": "Specification for all operating modes.",
      "properties": {
        "constant_current_CC": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Constant Current mode specifications"
        },
        "constant_voltage_CV": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Constant Voltage mode specifications"
        },
        "constant_power_CP": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Constant Power mode specifications"
        },
        "constant_resistance_CR": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Constant Resistance mode specifications"
        },
        "required_scpi_commands": {
          "description": "Required SCPI command aliases for mode switching (e.g., ['set_mode', 'set_load'])",
          "items": {
            "type": "string"
          },
          "title": "Required Scpi Commands",
          "type": "array"
        }
      },
      "title": "OperatingModesSpec",
      "type": "object"
    },
    "RangeSpec": {
      "description": "Specification for a range with accuracy information.",
      "properties": {
        "nominal": {
          "description": "Nominal range value",
          "title": "Nominal",
          "type": "number"
        },
        "max_current_A": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum current in Amperes",
          "title": "Max Current A"
        },
        "max_voltage_V": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum voltage in Volts",
          "title": "Max Voltage V"
        },
        "max_power_W": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum power in Watts",
          "title": "Max Power W"
        },
        "readback_accuracy": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccuracySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Readback accuracy specification"
        }
      },
      "required": [
        "nominal"
      ],
      "title": "RangeSpec",
      "type": "object"
    },
    "SCPICommandSpec": {
      "additionalProperties": false,
      "description": "Specification for a single SCPI command.",
      "properties": {
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SCPI command template with placeholders",
          "title": "Template"
        },
        "sequence": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sequence of SCPI commands",
          "title": "Sequence"
        },
        "parameters": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/SCPIParameterSpec"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parameter specifications for this command",
          "title": "Parameters"
        },
        "defaults": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default parameter values",
          "title": "Defaults"
        },
        "validators": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parameter validation rules",
          "title": "Validators"
        },
        "enums": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enumeration values for parameters",
          "title": "Enums"
        },
        "response": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Response specification",
          "title": "Response"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Command description",
          "title": "Description"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Command category (e.g., 'channel', 'trigger', 'acquisition')",
          "title": "Category"
        },
        "feature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Feature this command belongs to",
          "title": "Feature"
        }
      },
      "title": "SCPICommandSpec",
      "type": "object"
    },
    "SCPICommandsQueries": {
      "additionalProperties": false,
      "description": "SCPI commands and queries specification.",
      "properties": {
        "commands": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/SCPICommandSpec"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SCPI commands",
          "title": "Commands"
        },
        "queries": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/SCPICommandSpec"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SCPI queries",
          "title": "Queries"
        }
      },
      "title": "SCPICommandsQueries",
      "type": "object"
    },
    "SCPIParameterSpec": {
      "additionalProperties": false,
      "description": "Specification for a single SCPI command parameter.",
      "properties": {
        "name": {
          "description": "Parameter name",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "description": "Parameter type (e.g., 'int', 'float', 'str', 'enum')",
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": true,
          "description": "Whether this parameter is required",
          "title": "Required",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parameter description",
          "title": "Description"
        },
        "min_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum allowed value",
          "title": "Min Value"
        },
        "max_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum allowed value",
          "title": "Max Value"
        },
        "allowed_values": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allowed values for enum types",
          "title": "Allowed Values"
        },
        "default": {
          "default": null,
          "description": "Default parameter value",
          "title": "Default"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parameter units",
          "title": "Units"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parameter format specification",
          "title": "Format"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "SCPIParameterSpec",
      "type": "object"
    },
    "SCPISection": {
      "additionalProperties": false,
      "description": "Complete SCPI section specification.",
      "properties": {
        "commands": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/SCPICommandSpec"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SCPI commands",
          "title": "Commands"
        },
        "queries": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/SCPICommandSpec"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SCPI queries",
          "title": "Queries"
        },
        "variants": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/SCPICommandsQueries"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SCPI command variants",
          "title": "Variants"
        },
        "default_variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default variant name",
          "title": "Default Variant"
        },
        "feature_mappings": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declarative feature mapping: { feature_name: { required_scpi: [...], optional_scpi: [...] } }",
          "title": "Feature Mappings"
        }
      },
      "title": "SCPISection",
      "type": "object"
    },
    "TransientSpec": {
      "description": "Specification for transient capabilities.",
      "properties": {
        "supported_modes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Supported transient modes (e.g., ['CONTinuous', 'PULSe', 'TOGGle', 'LIST'])",
          "title": "Supported Modes"
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RangeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Transient time range"
        },
        "required_scpi_commands": {
          "description": "Required SCPI command aliases for transient functionality (e.g., ['transient_set_mode', 'transient_set_level', 'transient_start'])",
          "items": {
            "type": "string"
          },
          "title": "Required Scpi Commands",
          "type": "array"
        }
      },
      "title": "TransientSpec",
      "type": "object"
    }
  },
  "description": "Configuration for DC Active Load instruments.",
